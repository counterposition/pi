{
  "name": "@counterposition/skill-pi",
  "version": "0.87.1",
  "description": "Pi coding agent reference skill — extensions, settings, providers, SDK/RPC, packages, and .pi/ config",
  "keywords": [
    "ai-skill",
    "coding-agent",
    "pi",
    "pi-package",
    "reference"
  ],
  "homepage": "https://github.com/counterposition/pi/tree/main/packages/skill-pi",
  "bugs": {
    "url": "https://github.com/counterposition/pi/issues"
  },
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/counterposition/pi.git",
    "directory": "packages/skill-pi"
  },
  "files": [
    "skills/",
    "README.md",
    "LICENSE.md",
    "package.json"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "pnpm run lint:docs",
    "lint:docs": "markdownlint-cli2 \"README.md\"",
    "lint:docs:fix": "markdownlint-cli2 --fix \"README.md\"",
    "format": "oxfmt \"README.md\" \"package.json\" \"tests\" \"vitest.config.ts\"",
    "format:check": "oxfmt \"README.md\" \"package.json\" \"tests\" \"vitest.config.ts\" --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "node ../../scripts/sync-skill-package.mjs",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test && pnpm run pack:check",
    "pack:check": "pnpm pack --pack-destination ../../.pack"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.99.1",
    "@earendil-works/pi-coding-agent": "^0.99.1",
    "@types/node": "^25.5.0",
    "typebox": "^1.3.16",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=24"
  },
  "pi": {
    "skills": [
      "skills/pi"
    ]
  }
}
